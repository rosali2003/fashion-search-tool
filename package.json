{
  "name": "ink",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "scrape:aritzia": "pnpm --filter scrapers scrape:aritzia",
    "scrape:gap": "pnpm --filter scrapers scrape:gap",
    "scrape:uniqlo": "pnpm --filter scrapers scrape:uniqlo",
    "scrape:rihoas": "pnpm --filter scrapers scrape:rihoas",
    "scrape:everlane": "pnpm --filter scrapers scrape:everlane",
    "scrape:skims": "pnpm --filter scrapers scrape:skims",
    "scrape:reformation": "pnpm --filter scrapers scrape:reformation",
    "scrape:madewell": "pnpm --filter scrapers scrape:madewell",
    "scrape:sezane": "pnpm --filter scrapers scrape:sezane",
    "scrape:all": "pnpm --filter scrapers scrape:all",
    "refresh": "tsx scripts/refresh.ts",
    "sync:images": "tsx --env-file-if-exists=.env scripts/sync-images-to-r2.ts",
    "test": "pnpm --filter backend test && pnpm --filter scrapers test",
    "eval": "pnpm --filter backend eval",
    "brands": "pnpm --filter backend brands",
    "ingest": "pnpm --filter backend ingest",
    "enrich": "pnpm --filter backend enrich",
    "migrate": "pnpm --filter backend migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "b",
      "d",
      "e",
      "esbuild",
      "i",
      "l",
      "s",
      "u"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "tsx": "^4.23.11"
  }
}
