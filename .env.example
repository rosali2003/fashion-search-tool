# Postgres. This points at the ParadeDB container in docker-compose.yml, which
# publishes on 5433 because a local Postgres already occupies 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ink

PORT=3000

# ── LLM ──────────────────────────────────────────────────────────────────────
# Used for query expansion, result reranking, and both text and vision attribute
# extraction at ingest. Entirely optional: without a key the app degrades to
# pure BM25 — search still returns results, just without match reasons or
# LLM-extracted attributes. The UI says so rather than pretending.
#
# Set the key for whichever provider INK_MODEL selects. Both can be set at once;
# only the one matching the active model is used, which makes A/B comparison a
# one-variable change.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which model to use. Provider is derived from the model id — there is no
# separate provider setting to get out of sync. Registry: backend/src/llm/models.ts
#
#   openai      gpt-5-nano (default), gpt-5-mini, gpt-5.4-nano, gpt-5.4-mini, gpt-5
#   anthropic   claude-haiku-4-5-20251001, claude-sonnet-5, claude-opus-5
#
# gpt-5-nano is the default: ~17x cheaper per search than claude-haiku-4-5 on this
# workload, and OpenAI's strict Structured Outputs enforce the controlled
# vocabulary by constrained decoding rather than merely encouraging it.
#
# Whether it is good enough at RERANKING — the one stage doing real judgement — is
# unverified. Compare before trusting it:
#   INK_MODEL=gpt-5-nano                pnpm eval -- --full --repeat 3
#   INK_MODEL=claude-haiku-4-5-20251001 pnpm eval -- --full --repeat 3
INK_MODEL=gpt-5-nano

# DEAD CONFIG — read by nothing. The image store root is hardcoded to
# <repo>/output/images (backend/src/ingest/images.ts), so setting this has no
# effect. Kept only so nobody re-adds it believing it works; do not set it in a
# deployment.
IMAGE_ROOT=./output/images

# --- Deployment -------------------------------------------------------------

# TLS for the Postgres connection. Opt-in, because the local docker-compose
# database and a private-network hosted one both serve plaintext, so defaulting
# to `require` would break the ordinary case.
#
#   unset / disable   no TLS (local, private networking)
#   require           TLS, certificate not verified — the usual hosted case
#   verify-full       TLS with full chain verification
# DATABASE_SSL=

# Public base URL of the object-storage bucket holding product images. When set,
# the API returns absolute image URLs and browsers fetch straight from the CDN;
# when unset it returns /api/images/<hash> and the backend streams from local
# disk, which is what development and the eval harness rely on.
#
# Keys are the bare content hash with no extension — see
# backend/src/routes/imageUrl.ts and scripts/sync-images-to-r2.sh.
# IMAGE_CDN_BASE=https://images.example.com
