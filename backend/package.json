{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "brands": "tsx src/brands/cli.ts",
    "ingest": "tsx src/ingest/run.ts",
    "eval": "tsx evals/src/run.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "enrich": "tsx src/ingest/enrich.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.7.4",
    "kysely": "^0.27.4",
    "openai": "^7.4.0",
    "openid-client": "^6.8.8",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
